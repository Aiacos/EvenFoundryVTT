{
  "name": "@evf/g2-app",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "EVF glasses app — Even Hub G2 plugin: D&D-sheet HUD streamed from the player's Foundry tab through the relay (ADR-0019).",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest --run --project g2-app --root ../..",
    "typecheck": "tsc --noEmit && tsc -p scripts",
    "dev:demo": "vite --open '/?demo=tour'",
    "sim:check": "tsx scripts/sim-check.ts"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "@evenrealities/pretext": "0.1.4",
    "@evf/shared-protocol": "workspace:*",
    "@evf/shared-render": "workspace:*",
    "jsqr": "1.4.0",
    "upng-js": "2.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "vite": "8.0.11"
  }
}
