{
  "name": "@evf/g2-app",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "EVF G2 plugin host bundle — served via static HTTP to Even Realities App WebView (Phase 4a fills real implementation).",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest --run --project g2-app --root ../..",
    "typecheck": "tsc --noEmit && tsc -p scripts",
    "dev:demo": "vite --open '/?demo=tour'",
    "sim:check": "tsx scripts/sim-check.ts"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.15",
    "@evenrealities/pretext": "0.1.4",
    "@evf/shared-protocol": "workspace:*",
    "@evf/shared-render": "workspace:*",
    "socket.io-client": "4.8.3",
    "upng-js": "2.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "vite": "8.0.11"
  }
}
