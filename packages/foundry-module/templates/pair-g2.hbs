{{!--
  «Collega occhiali G2» (ADR-0019) — one window for players and GMs.
  Rendered by src/direct/PairG2App.ts (HandlebarsApplicationMixin, part "main").
  Styles: styles/pair-g2.css (scoped under .evf-pair). No inline styles.
  qrSvg is generated locally by the qrcode library from our own URL (trusted SVG).
  States: no-actor · preparing · relay-down · session (QR + countdown + code + live status + «Annulla QR») · expired · cancelled · connected.
  A non-default app page / relay shows a notice with «Ripristina predefinito» on top.
--}}
<section class="evf-pair{{#if bigQr}} evf-pair--big-qr{{/if}}" data-state="{{#if connected}}connected{{else if session}}session{{else if expired}}expired{{else if cancelled}}cancelled{{else}}idle{{/if}}">

  {{#each endpointNotices}}
  <div class="evf-pair__notice evf-pair__notice--{{tone}} evf-pair__endpoint" role="alert" data-endpoint-notice="{{kind}}">
    <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
    <span>{{localize label}} <code>{{url}}</code></span>
    <button type="button" data-action="resetEndpoint" data-endpoint="{{which}}">{{localize "evf.pair.notice.reset"}}</button>
  </div>
  {{/each}}

  {{#if noActor}}
  <p class="evf-pair__notice evf-pair__notice--warn"><i class="fas fa-circle-info" aria-hidden="true"></i> {{localize "evf.pair.no_actor"}}</p>
  {{else}}
  <div class="evf-pair__pickers">
    <label class="evf-pair__field">
      <span>{{localize "evf.pair.character"}}</span>
      <select data-field="actor">
        {{#each actors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
      </select>
    </label>
  </div>

  {{#if connected}}
  <div class="evf-pair__success" role="status">
    <i class="fas fa-circle-check evf-pair__success-icon" aria-hidden="true"></i>
    <div>
      <p class="evf-pair__success-title">{{localize "evf.pair.connected.title"}} · {{connected}}</p>
      <p class="evf-pair__muted">{{localize "evf.pair.connected.body"}}</p>
    </div>
    <button type="button" data-action="newQr">{{localize "evf.pair.connected.another"}}</button>
  </div>
  {{else if session}}
  <div class="evf-pair__stage">
    <div class="evf-pair__qr" role="button" tabindex="0" data-action="toggleQrSize" aria-label="{{localize "evf.pair.qr_alt"}}">{{{session.qrSvg}}}</div>
    <div class="evf-pair__guide">
      <ol class="evf-pair__steps">
        <li><span class="evf-pair__step-no">1</span>{{localize "evf.pair.step1"}}</li>
        <li><span class="evf-pair__step-no">2</span>{{localize "evf.pair.step2"}}</li>
      </ol>
      <div class="evf-pair__countdown">
        <div class="evf-pair__countdown-row">
          <span>{{localize "evf.pair.expires_in"}}</span>
          <strong class="evf-pair__timer" data-countdown>{{session.remaining}}</strong>
        </div>
        <progress data-countdown-bar max="{{session.secondsTotal}}" value="{{session.secondsLeft}}"></progress>
        <span class="evf-pair__muted">{{localize "evf.pair.single_use"}}</span>
        <button type="button" class="evf-pair__qr-size" data-action="toggleQrSize"><i class="fas {{#if bigQr}}fa-compress{{else}}fa-expand{{/if}}" aria-hidden="true"></i> {{#if bigQr}}{{localize "evf.pair.qr_smaller"}}{{else}}{{localize "evf.pair.qr_bigger"}}{{/if}}</button>
        <button type="button" class="evf-pair__cancel" data-action="cancelQr"><i class="fas fa-ban" aria-hidden="true"></i> {{localize "evf.pair.cancel_qr"}}</button>
      </div>
      <ul class="evf-pair__live" aria-live="polite">
        {{#each live}}
        <li class="evf-pair__live-item evf-pair__live-item--{{state}}"><i class="fas {{icon}}" aria-hidden="true"></i> {{localize label}}</li>
        {{/each}}
      </ul>
      <div class="evf-pair__code">
        <span class="evf-pair__label">{{localize "evf.pair.manual_code"}}</span>
        <div class="evf-pair__code-row">
          <code class="evf-pair__code-value">{{#each session.codeGroups}}<span>{{this}}</span>{{/each}}</code>
          <button type="button" class="evf-pair__icon-btn" data-action="copyCode" data-tooltip="{{localize "evf.pair.copy_code"}}" aria-label="{{localize "evf.pair.copy_code"}}"><i class="fas fa-copy" aria-hidden="true"></i></button>
        </div>
        <span class="evf-pair__muted">{{localize "evf.pair.phone_hint"}}</span>
      </div>
    </div>
  </div>
  {{else if expired}}
  <p class="evf-pair__notice evf-pair__notice--warn"><i class="fas fa-hourglass-end" aria-hidden="true"></i> {{localize "evf.pair.expired"}}</p>
  <footer class="evf-pair__footer">
    <button type="button" class="evf-pair__primary" data-action="newQr"><i class="fas fa-qrcode" aria-hidden="true"></i> {{localize "evf.pair.new_qr"}}</button>
  </footer>
  {{else if cancelled}}
  <p class="evf-pair__notice evf-pair__notice--warn"><i class="fas fa-ban" aria-hidden="true"></i> {{localize "evf.pair.cancelled"}}</p>
  <footer class="evf-pair__footer">
    <button type="button" class="evf-pair__primary" data-action="newQr"><i class="fas fa-qrcode" aria-hidden="true"></i> {{localize "evf.pair.new_qr"}}</button>
  </footer>
  {{else if relayDown}}
  <p class="evf-pair__notice evf-pair__notice--error">
    <i class="fas fa-circle-xmark" aria-hidden="true"></i>
    <span>{{localize "evf.pair.relay_down"}} <code>{{relayUrl}}</code> <a href="{{guide}}" target="_blank" rel="noopener">{{localize "evf.pair.guide_link"}}</a></span>
  </p>
  <footer class="evf-pair__footer">
    <button type="button" class="evf-pair__primary" data-action="recheck"><i class="fas fa-rotate" aria-hidden="true"></i> {{localize "evf.pair.recheck"}}</button>
  </footer>
  {{else}}
  <p class="evf-pair__muted">{{localize "evf.pair.preparing"}}</p>
  {{/if}}
  {{/if}}

  <div class="evf-pair__devices">
    <h3>{{localize "evf.pair.devices.heading"}}</h3>
    {{#if devices.length}}
    <ul>
      {{#each devices}}
      <li class="evf-pair__device">
        <span class="evf-pair__dot evf-pair__dot--{{status}}" data-tooltip="{{localize statusLabel}}"></span>
        <span class="evf-pair__device-name">{{label}}</span>
        <span class="evf-pair__muted">{{localize statusLabel}}</span>
        <span class="evf-pair__muted evf-pair__device-seen">{{lastSeen}}</span>
        {{#if confirming}}
        <span class="evf-pair__confirm">
          <span>{{localize "evf.pair.revoke.confirm"}}</span>
          <button type="button" class="evf-pair__danger" data-action="confirmRevoke" data-device-id="{{deviceId}}">{{localize "evf.pair.revoke.proceed"}}</button>
        </span>
        {{else}}
        <button type="button" data-action="revoke" data-device-id="{{deviceId}}">{{localize "evf.pair.revoke.button"}}</button>
        {{/if}}
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="evf-pair__muted">{{localize "evf.pair.devices.empty"}}</p>
    {{/if}}
  </div>
</section>
